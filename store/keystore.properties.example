# Copy this file to the repository root as `keystore.properties` and fill in your
# own values. It is git-ignored on purpose — never commit real credentials.
#
# The keystore file path is resolved relative to the repository root.
storeFile=spimp3-release.p12
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME

# Create a key pair with (PKCS#12, the format Android tooling expects):
#   keytool -genkeypair -v \
#     -keystore spimp3-release.p12 -storetype PKCS12 \
#     -alias spimp3 -keyalg RSA -keysize 4096 -validity 10000
#
# BACK THIS FILE UP SOMEWHERE SAFE. If you lose it you can never publish an
# update to an existing app listing again: every store requires all releases of
# an app to share one signing key.
